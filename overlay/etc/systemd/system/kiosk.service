[Unit]
Description=Kiosk: browser session (cage + browser) on tty1
After=systemd-user-sessions.service kiosk-config.service NetworkManager.service
Wants=kiosk-config.service
Conflicts=getty@tty1.service
ConditionKernelCommandLine=!kiosk.installer

[Service]
Type=simple
User=kiosk
PAMName=kiosk
EnvironmentFile=/run/kiosk/env
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/local/bin/kiosk-session
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
