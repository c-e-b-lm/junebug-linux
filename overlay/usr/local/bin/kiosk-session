#!/bin/bash
# Runs as user "kiosk" on tty1 (started by kiosk.service): starts the cage compositor
# with browser controls by default, or in kiosk mode for a configured URL.
# Environment comes from /run/kiosk/env.
set -u
# shellcheck disable=SC1091
source /etc/kiosk/release

: "${KIOSK_URL:=}"
: "${KIOSK_MODE:=auto}"
: "${KIOSK_LANG:=en}"
: "${KIOSK_KEYMAP:=us}"
: "${KIOSK_SCALE:=1}"
: "${KIOSK_INCOGNITO:=0}"
: "${KIOSK_FRESH_PROFILE:=1}"
: "${KIOSK_ALLOW_ZOOM:=0}"
: "${KIOSK_AUTOPLAY:=1}"
: "${KIOSK_WAIT_NETWORK:=20}"
: "${KIOSK_DEBUG:=0}"
: "${KIOSK_BROWSER_ARGS:=}"

case "$KIOSK_MODE" in
    auto) kiosk_mode=0; [[ -z "$KIOSK_URL" ]] || kiosk_mode=1 ;;
    browser) kiosk_mode=0 ;;
    kiosk) kiosk_mode=1 ;;
    *) echo "invalid KIOSK_MODE=$KIOSK_MODE (expected auto, browser or kiosk)" >&2; exit 1 ;;
esac
# Choose the default page only after resolving auto mode: the Google fallback
# is not a configured kiosk URL.
: "${KIOSK_URL:=https://www.google.com/}"

export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=cage
export LANG=C.UTF-8 LANGUAGE="$KIOSK_LANG"
export XKB_DEFAULT_LAYOUT="${KIOSK_KEYMAP%%:*}"
[[ "$KIOSK_KEYMAP" == *:* ]] && export XKB_DEFAULT_VARIANT="${KIOSK_KEYMAP#*:}"
export WLR_RENDERER_ALLOW_SOFTWARE=1
export MOZ_ENABLE_WAYLAND=1
export CHROME_DEVEL_SANDBOX=

PROFILE="$HOME/.config/kiosk-browser"
[[ "$KIOSK_FRESH_PROFILE" == "1" ]] && rm -rf "$PROFILE"
mkdir -p "$PROFILE"

case "$KIOSK_URL" in
    http://*|https://*) nm-online -q -t "$KIOSK_WAIT_NETWORK" || echo "kiosk-session: network not up after ${KIOSK_WAIT_NETWORK}s, starting anyway" >&2 ;;
esac

# shellcheck disable=SC2206
extra=($KIOSK_BROWSER_ARGS)
case "$BROWSER" in
    chrome|chromium)
        bin=google-chrome-stable; [[ "$BROWSER" == chromium ]] && bin=chromium
        cmd=("$bin" --ozone-platform=wayland --no-first-run --noerrdialogs --disable-infobars
             --disable-session-crashed-bubble --disable-component-update --check-for-update-interval=31536000
             --password-store=basic --user-data-dir="$PROFILE" --disk-cache-size=104857600
             --lang="$KIOSK_LANG" --force-device-scale-factor="$KIOSK_SCALE" --overscroll-history-navigation=0)
        [[ "$kiosk_mode" == 0 ]] || cmd+=(--kiosk)
        [[ "$KIOSK_ALLOW_ZOOM" == "1" ]] || cmd+=(--disable-pinch)
        [[ "$KIOSK_INCOGNITO" == "1" ]] && cmd+=(--incognito)
        [[ "$KIOSK_AUTOPLAY" == "1" ]] && cmd+=(--autoplay-policy=no-user-gesture-required)
        cmd+=("${extra[@]}")
        ;;
    firefox)
        cmd=(firefox --no-remote --profile "$PROFILE")
        [[ "$kiosk_mode" == 0 ]] || cmd+=(--kiosk)
        [[ "$KIOSK_INCOGNITO" == "1" ]] && cmd+=(--private-window)
        cmd+=("${extra[@]}")
        ;;
    *) echo "unknown BROWSER=$BROWSER" >&2; sleep 10; exit 1 ;;
esac
[[ -z "$KIOSK_URL" ]] || cmd+=("$KIOSK_URL")

cage_opts=(-d)
[[ "$KIOSK_DEBUG" == "1" ]] && cage_opts+=(-s)   # allow VT switching for debugging
exec cage "${cage_opts[@]}" -- "${cmd[@]}"
